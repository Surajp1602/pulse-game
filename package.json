{
  "name": "pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PULSE: a real-time micro-game gauntlet for 2-8 players on their own phones.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "vite build && node test/e2e/flow.mjs",
    "jury": "vite build && node tools/jury/capture.mjs",
    "jury:quick": "vite build && node tools/jury/capture.mjs --quick",
    "doctor": "node tools/doctor.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "an-array-of-english-words": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
